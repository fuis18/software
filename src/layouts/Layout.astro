---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import { defaultLang, hreflangOf, languages, ogLocaleOf } from '@/i18n/config';
import { getBase, getLangFromPath, localizePath } from '@/i18n/routing';

const { frontmatter } = Astro.props;
const siteName = 'software';

const currentPath = Astro.url.pathname;
const lang = Astro.currentLocale ?? getLangFromPath(currentPath);

const title = frontmatter?.title || 'Knowledge';
const eyebrow = frontmatter?.eyebrow || 'software';
const subtitle = frontmatter?.subtitle;
const pageTitle = `${title} — ${siteName}`;
const description =
  frontmatter?.description || `${title}${subtitle ? ` — ${subtitle}` : ''}`;
const canonical = new URL(currentPath, Astro.site);

const ogLocale = ogLocaleOf(lang);
const ogLocaleAlternates = languages
  .filter((code) => code !== lang)
  .map((code) => ogLocaleOf(code));

const alternates = languages.map((code) => ({
  code,
  href: new URL(localizePath(currentPath, code), Astro.site).href,
}));
const xDefault = new URL(localizePath(currentPath, defaultLang), Astro.site).href;
const sitemapHref = `${getBase()}sitemap-index.xml`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Fuis18">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0d0f14">
  <link rel="canonical" href={canonical}>
  {alternates.map((alternate) => (
    <link rel="alternate" hreflang={hreflangOf(alternate.code)} href={alternate.href}>
  ))}
  <link rel="alternate" hreflang="x-default" href={xDefault}>
  <link rel="sitemap" href={sitemapHref}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={siteName}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={ogLocale}>
  {ogLocaleAlternates.map((alternate) => (
    <meta property="og:locale:alternate" content={alternate}>
  ))}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored === 'light' || stored === 'dark'
        ? stored
        : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f9fc' : '#0d0f14');
    })();
  </script>
</head>
<body>
  <div class="container">
    <Navbar />
    <section class="page-header">
      {eyebrow && <h1>{eyebrow}</h1>}
      <p>{title} {subtitle && <span>{subtitle}</span>}</p>
    </section>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>
