---
import '@/styles/global.css';
import Head from "./Head.astro";
import Navbar from '@/components/Navbar.astro';
import { getLangFromPath } from '@/i18n/routing';

const { frontmatter } = Astro.props;

const currentPath = Astro.url.pathname;
const lang = Astro.currentLocale ?? getLangFromPath(currentPath);

const title = frontmatter?.title || 'Knowledge';
const eyebrow = frontmatter?.eyebrow || 'software';
const subtitle = frontmatter?.subtitle;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <Head lang={lang} frontmatter={frontmatter} />
</head>
<body>
  <div class="container">
    <Navbar />
    <section class="page-header">
      {eyebrow && <h1>{eyebrow}</h1>}
      <p>{title} {subtitle && <span>{subtitle}</span>}</p>
    </section>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>
