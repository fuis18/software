---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const currentPath = Astro.url.pathname;
const langMatch = currentPath.match(/\/(es|en)\//);
const currentLang = langMatch ? langMatch[1] : 'es';

const otherLang = currentLang === 'es' ? 'en' : 'es';
const otherLangLabel = currentLang === 'es' ? 'EN' : 'ES';

const switchPath = currentPath.replace(`/${currentLang}/`, `/${otherLang}/`);

const links = [
  { label: 'Dev', href: `${base}${currentLang}/dev/` },
  { label: 'Sec', href: `${base}${currentLang}/sec/` },
  { label: 'Ops', href: `${base}${currentLang}/ops/` },
  { label: 'AI', href: `${base}${currentLang}/ai/` },
  { label: 'Games', href: `${base}${currentLang}/games/` },
];
const githubUrl = 'https://github.com/fuis18/software/';
---

<header class="navbar">
  <a href={`${base}${currentLang}/`} class="brand" aria-label="Go to home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m8 6-5 6 5 6" />
      <path d="m16 6 5 6-5 6" />
      <path d="m13 4-2 16" />
    </svg>
  </a>

  <nav class="nav-links" aria-label="Main navigation">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="nav-actions">
    <div class="lang-switcher">
      <button type="button" class="icon-btn lang-toggle" aria-label="Switch language" aria-expanded="false" aria-haspopup="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span class="lang-label">{currentLang.toUpperCase()}</span>
      </button>
      <div class="lang-dropdown" role="menu">
        <a href={currentPath.replace(`/${currentLang}/`, '/es/')} class:list={['lang-option', { active: currentLang === 'es' }]} role="menuitem" data-lang="es">
          ES
        </a>
        <a href={currentPath.replace(`/${currentLang}/`, '/en/')} class:list={['lang-option', { active: currentLang === 'en' }]} role="menuitem" data-lang="en">
          EN
        </a>
      </div>
    </div>

    <a href={githubUrl} class="icon-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
      </svg>
    </a>

    <button type="button" class="icon-btn theme-toggle" aria-label="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.73 12.73 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>
</header>

<style>
  .navbar {
    display: grid;
    grid-template-areas: "brand links actions";
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    transition: transform 0.25s ease;
  }

  .navbar.nav-hidden {
    transform: translateY(-100%);
  }

  .nav-links ul {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .icon-link,
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .icon-link:hover,
  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--border-light);
  }

  .icon-link svg,
  .icon-btn svg {
    width: 18px;
    height: 18px;
  }

  .icon-moon {
    display: none;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    color: var(--accent);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .brand svg {
    width: 18px;
    height: 18px;
  }

  .brand:hover {
    color: var(--text);
    border-color: var(--border-light);
  }

  .nav-links {
    grid-area: links;
  }

  .lang-switcher {
    position: relative;
  }

  .lang-toggle {
    width: auto !important;
    padding: 0 10px !important;
    gap: 6px;
  }

  .lang-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px;
    min-width: 48px;
    display: none;
    z-index: 200;
  }

  .lang-dropdown.open {
    display: block;
  }

  .lang-dropdown .lang-option {
    display: block;
    width: 100%;
    padding: 8px 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    text-decoration: none;
    text-align: center;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .lang-dropdown .lang-option:hover {
    color: var(--accent);
    background: var(--bg);
  }

  .lang-dropdown .lang-option.active {
    color: var(--accent);
  }

  @media (max-width: 460px) {
    .navbar {
      grid-template-areas:
        "brand actions"
        "links links";
      grid-template-columns: 1fr auto;
    }

    .nav-links ul {
      justify-content: center;
      gap: 0 28px;
    }
  }
  @media (max-width: 340px) {
    .nav-links ul {
      gap: 0 14px;
    }
  }
</style>

<script>
  const header = document.querySelector('.navbar');
  const HIDE_AT = 80;
  const DELTA = 10;
  let lastY = window.scrollY;
  let ticking = false;

  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (Math.abs(y - lastY) > DELTA) {
          header.classList.toggle('nav-hidden', y > lastY && y > HIDE_AT);
          lastY = y;
        }
        ticking = false;
      });
    },
    { passive: true },
  );

  const langToggle = document.querySelector('.lang-toggle');
  const langDropdown = document.querySelector('.lang-dropdown');

  if (langToggle && langDropdown) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langDropdown.classList.toggle('open');
      langToggle.setAttribute('aria-expanded', isOpen);
    });

    document.addEventListener('click', () => {
      langDropdown.classList.remove('open');
      langToggle.setAttribute('aria-expanded', 'false');
    });

    langDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    const langOptions = document.querySelectorAll('.lang-option');
    langOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const lang = option.getAttribute('data-lang');
        if (lang) {
          localStorage.setItem('lang', lang);
          document.cookie = `lang=${lang};path=/;max-age=31536000`;
        }
      });
    });
  }
</script>
